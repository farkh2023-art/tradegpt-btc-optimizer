# =============================================================
# TradeGPT BTC Optimizer — Configuration
# Copiez ce fichier en .env et adaptez les valeurs
# NE JAMAIS committer le fichier .env dans git
# =============================================================

# Fournisseur IA : openai | anthropic | mock
AI_PROVIDER=mock

# Clé API OpenAI (optionnel — laissez vide pour le mode mock)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Clé API Anthropic (optionnel — laissez vide pour le mode mock)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Base de données SQLite (chemin relatif au backend/)
DATABASE_URL=sqlite:///./tradegpt.db

# Debug (true | false)
DEBUG=false

# CORS origins (séparés par des virgules)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# =============================================================
# eToro Integration — LECTURE SEULE UNIQUEMENT
# ETORO_ALLOW_REAL_ORDERS doit toujours rester à false
# =============================================================
ETORO_API_ENABLED=false
ETORO_API_BASE_URL=https://public-api.etoro.com
ETORO_PUBLIC_API_KEY=
ETORO_USER_KEY=
ETORO_MODE=read_only
ETORO_ALLOW_REAL_ORDERS=false
